with "config/database_inspect_config.gpr";

project Database_Inspect is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Database_Inspect_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("database_inspect.adb",
      "database_inspect_make_encrypted_fixture.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Database_Inspect_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Database_Inspect;
