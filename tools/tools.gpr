with "config/database_tools_config.gpr";

project Tools is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Database_Tools_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_all.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Database_Tools_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Tools;
